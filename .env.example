# ===================================================
# THREADLY ENVIRONMENT CONFIGURATION
# ===================================================

# Server Configuration
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
WIDGET_URL=http://localhost:5175

# Database Configuration
# In development, leave empty to automatically launch embedded in-memory MongoDB
MONGODB_URI=mongodb://localhost:27017/threadly
DB_NAME=threadly

# Authentication (Better Auth & JWT)
BETTER_AUTH_SECRET=generate_a_random_32_character_secret_key_here
BETTER_AUTH_URL=http://localhost:3000
JWT_SECRET=generate_a_random_32_character_jwt_access_secret
JWT_REFRESH_SECRET=generate_a_random_32_character_jwt_refresh_secret

# OAuth Providers (Optional in dev; dev-login simulation available)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Cloudflare R2 Avatar Storage (Optional - falls back to provider URL)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_AVATAR_BUCKET=threadly-avatars
R2_PUBLIC_URL=https://cdn.threadly.example/avatars

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_MS=60000

# ===================================================
# Cloudflare Domain Management System
# ===================================================
# Set MOCK_CLOUDFLARE=true to enable MockCloudflareProvider for local development
# without making real Cloudflare API or DNS changes.
MOCK_CLOUDFLARE=true

# Base domain owned and managed by Threadly (e.g. threadly.com)
CLOUDFLARE_BASE_DOMAIN=threadly.com

# Cloudflare API credentials (scoped token with Zone.DNS and Zone.CustomHostnames permissions)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# CNAME target for Threadly-owned subdomains (e.g. app.threadly.com)
THREADLY_DOMAIN_TARGET=app.threadly.com

# CNAME target for Customer custom hostnames / Cloudflare for SaaS (e.g. customers.threadly.com)
THREADLY_CUSTOM_HOSTNAME_TARGET=customers.threadly.com

